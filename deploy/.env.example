# Domínio que aponta para o IP público da VPS. Sem domínio próprio, use o
# sslip.io: para o IP 129.151.10.20 -> DOMAIN=129-151-10-20.sslip.io
DOMAIN=pedigree.exemplo.com.br

# Login do site. Gere o hash com:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'sua-senha'
# Mantenha as aspas SIMPLES em volta do hash (ele contém "$").
AUTH_USER=admin
AUTH_HASH='$2a$14$troque-pelo-hash-gerado'

# Senha do Postgres (só acessível de dentro do docker, mas use algo forte).
POSTGRES_PASSWORD=troque-esta-senha
