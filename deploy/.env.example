# Domínio que aponta para o IP público da VPS (só o nome, sem https:// nem /).
# Sem domínio próprio: DuckDNS (ex: meusite.duckdns.org) ou sslip.io
# (para o IP 129.151.10.20 -> DOMAIN=129-151-10-20.sslip.io).
DOMAIN=pedigree.exemplo.com.br

# Senha do Postgres (só acessível de dentro do docker, mas use algo forte).
POSTGRES_PASSWORD=troque-esta-senha

# Chave que assina as sessões de login. Gere com: openssl rand -hex 32
# Trocar essa chave desloga todo mundo.
SECRET_KEY=troque-pela-chave-gerada
